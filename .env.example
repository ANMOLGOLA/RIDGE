# RIDGE Configuration
PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development

# TinyFish Web Intelligence
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_MODE=live # live | fixture
ENABLE_TINYFISH_AGENT=false

# LLM Extraction
LLM_PROVIDER=none # anthropic | none
ANTHROPIC_API_KEY=

# Database
# Default: SQLite with GeoJSON fallbacks for zero-setup local dev; or PostgreSQL+PostGIS for Docker
DATABASE_URL=sqlite:///./ridge.db
# DATABASE_URL=postgresql://ridge:ridge@localhost:5432/ridge

# Redis (optional, falls back to in-memory)
REDIS_URL=

# Ingestion & Scheduling
INGEST_INTERVAL_MIN=15
RISK_REFRESH_MIN=30

# Feature Flags
ENABLE_VISION=false
ENABLE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
